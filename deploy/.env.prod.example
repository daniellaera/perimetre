# .env.prod in the app directory on the server (/opt/perimetre by default), mode 600, never committed.
# Read by docker compose (--env-file, for the db service) and passed whole to
# the backend (env_file). Generate secrets with: openssl rand -hex 32
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://db:5432/perimetre
DB_USER=perimetre
DB_PASSWORD=change-me
FIREBASE_CREDENTIALS=/secrets/firebase-service-account.json
# Bearer token for /admin/** (at least 32 characters). Rotate by replacing it and recreating the backend.
ADMIN_TOKEN=change-me
# Optional dead-man's switch for the scheduled imports (healthchecks.io ping URL, without /start).
# Empty = no pings.
HEALTHCHECK_PING_URL=
# Optional: the import schedules (Spring cron, Europe/Zurich). Defaults in application.yml run after SITG's
# morning publication; keep the healthchecks.io check's schedule in line with the incremental one.
# IMPORT_INCREMENTAL_CRON=0 15 10 * * *
# IMPORT_FULL_CRON=0 45 10 * * SUN
