<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to GoogleService-Info.plist (git-ignored): the Xcode project bundles that file, so the build needs it.
  The native Firebase SDK reads this file at launch and validates its format, so the placeholders are fake
  but well-formed (key: "A" + 38 characters). They reach no Firebase project: without a generated
  lib/firebase_options.dart the app uses its push stub. `flutterfire configure` writes the real
  file (see README, "Push notifications").
-->
<plist version="1.0">
<dict>
	<key>API_KEY</key>
	<string>Axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PLIST_VERSION</key>
	<string>1</string>
	<key>BUNDLE_ID</key>
	<string>ch.perimetre.app</string>
	<key>PROJECT_ID</key>
	<string>your-firebase-project</string>
	<key>STORAGE_BUCKET</key>
	<string>your-firebase-project.firebasestorage.app</string>
	<key>IS_ADS_ENABLED</key>
	<false></false>
	<key>IS_ANALYTICS_ENABLED</key>
	<false></false>
	<key>IS_APPINVITE_ENABLED</key>
	<true></true>
	<key>IS_GCM_ENABLED</key>
	<true></true>
	<key>IS_SIGNIN_ENABLED</key>
	<true></true>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
