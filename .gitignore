.env
.env.*
!.env.prod.example
*.log
.idea/
.DS_Store
backend/build/
backend/.gradle/
app/build/
app/.dart_tool/
# Per-session port overrides (see CLAUDE.md "Local ports")
docker-compose.override.yml

# Local secrets (Firebase service-account JSON, see CLAUDE.md)
backend/.secrets/

# Firebase client config, generated per deployment by `flutterfire configure` (see README). The *.example
# files next to them are the committed placeholders.
app/lib/firebase_options.dart
app/ios/Runner/GoogleService-Info.plist
app/android/app/google-services.json
app/firebase.json

# Apple keys and certificates
*.p8
*.p12
*.mobileprovision

# Operator-only notes and tooling (prod host, paths, recipes): kept on the operator's machine.
CLAUDE.local.md
.claude/skills/ship/
.claude/settings.local.json

# Build-time app config (Mapbox tokens), passed with --dart-define-from-file: config/dev.json, config/prod.json.
# Only the placeholder is committed.
app/config/*.json
!app/config/example.json
