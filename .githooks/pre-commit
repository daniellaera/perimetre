#!/bin/sh
# Refuses a commit whose staged changes contain a secret (gitleaks with .gitleaks.toml: default rules plus any
# Mapbox token). Enable once per clone: git config core.hooksPath .githooks
# CI's secrets-scan job runs the same rules over the whole history.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks): staged changes not scanned." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
